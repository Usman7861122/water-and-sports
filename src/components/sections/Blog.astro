---
import Reveal from '../islands/Reveal';
import { POSTS } from '../../data/content';

const [featured, ...rest] = POSTS;
---

<section id="blog" class="section bg-sand">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <Reveal client:visible><p class="eyebrow">Health &amp; recovery insights</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="h-section mt-5">Expert advice, in <em>plain words.</em></h2></Reveal>
      </div>
      <Reveal client:visible delay={0.16}><a href="/blog/" class="link-arrow">Read all articles <span aria-hidden="true">→</span></a></Reveal>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-12">
      <Reveal client:visible className="lg:col-span-7">
        <article class="group relative h-full overflow-hidden rounded-3xl bg-ink text-white">
          <img src={featured.image} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/10" aria-hidden="true"></div>
          <div class="relative flex min-h-[28rem] flex-col justify-end p-7 md:min-h-[34rem] md:p-10">
            <p class="text-sm text-gold-light"><span class="font-semibold uppercase tracking-[0.16em]">{featured.tag}</span> · {featured.date}</p>
            <h3 class="mt-3 max-w-xl text-[1.75rem] leading-tight md:text-4xl">
              <a href={featured.href} class="after:absolute after:inset-0">{featured.title}</a>
            </h3>
            <p class="mt-4 max-w-xl text-white/80">{featured.excerpt}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gold-light">Read article <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span></span>
          </div>
        </article>
      </Reveal>

      <div class="grid gap-6 lg:col-span-5">
        {rest.map((p, i) => (
          <Reveal client:visible delay={0.1 * (i + 1)}>
            <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-[0_24px_50px_-30px_rgb(10_27_51/0.35)] sm:flex-row lg:flex-col xl:flex-row">
              <div class="aspect-[16/10] shrink-0 overflow-hidden sm:aspect-auto sm:w-2/5 lg:aspect-[16/9] lg:w-full xl:aspect-auto xl:w-2/5">
                <img src={p.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105" />
              </div>
              <div class="flex flex-col justify-center p-6">
                <p class="text-sm text-muted"><span class="font-semibold uppercase tracking-[0.16em] text-brand">{p.tag}</span> · {p.date}</p>
                <h3 class="mt-2 text-xl leading-snug text-ink"><a href={p.href} class="after:absolute after:inset-0">{p.title}</a></h3>
                <p class="mt-2 text-[0.95rem] text-muted">{p.excerpt}</p>
              </div>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </div>
</section>
