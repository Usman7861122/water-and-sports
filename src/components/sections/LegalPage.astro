---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../islands/Reveal';
import CtaBand from './CtaBand.astro';
import { LEGAL, LEGAL_LINKS } from '../../data/legal';

interface Props { slug: string }
const { slug } = Astro.props;
const page = LEGAL[slug];
---

<BaseLayout solidHeader title={`${page.title} | Water & Sports Physical Therapy`} description={page.description}>
  <section class="relative isolate overflow-hidden bg-mist/60 pb-12 pt-32 lg:pb-16 lg:pt-44">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-40 top-10 h-[30rem] w-[30rem] rounded-full bg-sky/25 blur-3xl"></div>
    </div>
    <div class="wrap">
      <Reveal client:load><a href="/" class="link-arrow text-sm"><span aria-hidden="true">←</span> Home</a></Reveal>
      <Reveal client:load delay={0.06}><p class="eyebrow mt-8">Legal</p></Reveal>
      <Reveal client:load delay={0.12}><h1 class="h-display mt-5 max-w-3xl">{page.title}</h1></Reveal>
      <Reveal client:load delay={0.2}><p class="lead mt-6 max-w-2xl">{page.intro}</p></Reveal>
      <Reveal client:load delay={0.26}><p class="mt-5 text-sm text-muted">Last updated: {page.updated}</p></Reveal>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-3" aria-label="On this page">
        <div class="lg:sticky lg:top-28">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand">On this page</p>
          <ol role="list" class="mt-4 grid gap-1 border-l border-ink/10">
            {page.sections.map((s) => <li><a href={`#${s.id}`} class="-ml-px flex min-h-10 items-center border-l-2 border-transparent pl-4 text-[0.92rem] text-muted transition-colors hover:border-brand hover:text-brand">{s.h}</a></li>)}
          </ol>
        </div>
      </aside>
      <article class="legal lg:col-span-9">
        {page.sections.map((s) => (
          <section id={s.id} class="scroll-mt-28">
            <h2>{s.h}</h2>
            {s.paras?.map((p) => <p>{p}</p>)}
            {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
            {s.after?.map((p) => <p>{p}</p>)}
          </section>
        ))}
        <nav class="mt-14 border-t border-ink/10 pt-8" aria-label="Other legal pages">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand">Related policies</p>
          <ul role="list" class="mt-4 flex flex-wrap gap-3">
            {LEGAL_LINKS.filter((l) => l.href !== `/${slug}/`).map((l) => <li><a href={l.href} class="inline-flex min-h-11 items-center rounded-lg border border-ink/10 bg-paper px-4 text-[0.95rem] text-ink transition-all duration-300 hover:-translate-y-0.5 hover:border-sky hover:bg-sky/25">{l.label}</a></li>)}
          </ul>
        </nav>
      </article>
    </div>
  </section>

  <CtaBand eyebrow="Questions?" text="Our team is happy to explain how we handle your information or help with any request." secondary={{ label: 'Find a clinic', href: '/locations/' }}>We’re here <em>to help.</em></CtaBand>
</BaseLayout>
