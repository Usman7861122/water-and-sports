---
import Reveal from '../islands/Reveal';
import ContactForm from '../islands/ContactForm';
import { BOOK_URL, EMAIL, HOURS, HOURS_NOTE, PHONE, PHONE_HREF } from '../../data/content';
---

<section id="contact" class="on-blue section relative overflow-hidden bg-sky text-ink">
  <div class="pointer-events-none absolute -left-32 top-0 h-[32rem] w-[32rem] rounded-full bg-white/45 blur-[130px]" aria-hidden="true"></div>
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 w-full opacity-30" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120c240-80 480-80 720-10s480 70 720-30V200H0z" fill="#fff" />
  </svg>

  <div class="wrap relative grid gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <Reveal client:visible><p class="eyebrow">Get in touch</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h-section mt-5">Let’s get you <em>moving again.</em></h2></Reveal>
      <Reveal client:visible delay={0.16}>
        <p class="lead mt-6">Have questions about our services? Reach out and we’ll respond within 24 hours — or book your visit online in about two minutes.</p>

        <dl class="mt-10 space-y-6">
          <div>
            <dt class="text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-ink/70">Phone</dt>
            <dd class="mt-1"><a href={PHONE_HREF} class="font-serif text-3xl text-ink hover:text-white">{PHONE}</a></dd>
          </div>
          <div>
            <dt class="text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-ink/70">Email</dt>
            <dd class="mt-1"><a href={`mailto:${EMAIL}`} class="text-lg text-ink hover:text-white">{EMAIL}</a></dd>
          </div>
          <div>
            <dt class="text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-ink/70">Office hours</dt>
            <dd class="mt-2 space-y-1 text-ink/85">
              {HOURS.map((h) => (
                <p class="flex max-w-xs justify-between gap-6"><span>{h.day}</span><span class="text-ink/70">{h.time}</span></p>
              ))}
              <p class="pt-1 text-sm text-ink/70">{HOURS_NOTE}</p>
            </dd>
          </div>
        </dl>
        <a href={BOOK_URL} class="btn btn-gold mt-10">Book Appointment Online</a>
      </Reveal>
    </div>

    <div class="lg:col-span-7">
      <Reveal client:visible delay={0.12}>
        <ContactForm client:visible />
      </Reveal>
    </div>
  </div>
</section>
