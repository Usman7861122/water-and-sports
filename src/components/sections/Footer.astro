---
import { BOOK_URL, CLINICS, HOURS, PHONE, PHONE_HREF, FOOTER_SERVICES, HOURS_NOTE, SITE, SOCIALS } from '../../data/content';
import { media } from '../../data/media';

const quick = [
  { label: 'Why WSPT', href: '/why-wspt/' },
  { label: 'Our Staff', href: '/staff/' },
  { label: 'Patient Forms', href: '/forms/' },
  { label: 'Insurance', href: '/insurance/' },
  { label: 'Employment', href: '/careers/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact Us', href: '/contact/' },
];
const icons: Record<string, string> = {
  Facebook: 'M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5H16.6V4.4c-.3 0-1.2-.1-2.3-.1-2.300 0-3.800 1.400-3.800 3.900v2.300H8v3h2.500V21z',
  X: 'M17.8 4h2.9l-6.300 7.200L21.800 20h-5.800l-4.500-5.900L6.300 20H3.400l6.700-7.700L3 4h5.900l4.100 5.400zM16.800 18.300h1.600L8 5.600H6.300z',
  YouTube: 'M21.600 8.200c-.2-.9-.9-1.600-1.800-1.800C18.200 6 12 6 12 6s-6.200 0-7.800.4c-.9.200-1.600.9-1.800 1.800C2 9.800 2 12 2 12s0 2.200.4 3.800c.2.900.9 1.600 1.800 1.800C5.800 18 12 18 12 18s6.200 0 7.800-.4c.9-.2 1.600-.9 1.800-1.800.4-1.600.4-3.800.4-3.800s0-2.200-.4-3.800zM10 14.800V9.200l4.800 2.800z',
};
---

<footer class="relative overflow-hidden border-t border-ink/10 bg-white text-ink">
  <div class="wrap pb-10 pt-20 lg:pt-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" aria-label={`${SITE.name} — home`}>
          <img src={media.logo} alt={SITE.name} width="120" height="70" loading="lazy" class="h-16 w-auto" />
        </a>
        <p class="mt-6 max-w-xs text-muted">Dedicated to providing exceptional physical therapy and rehabilitation services to help you move better.</p>
        <a href={PHONE_HREF} class="mt-6 inline-block font-serif text-2xl text-ink">{PHONE}</a>
        <div class="mt-6 flex gap-3">
          {SOCIALS.map((s) => (
            <a href={s.href} aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-ink/20 text-ink transition-colors hover:border-brand hover:text-brand">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons[s.label]} /></svg>
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Quick links" class="lg:col-span-2">
        <h3 class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-brand">Quick links</h3>
        <ul class="mt-4 space-y-1">
          {quick.map((l) => <li><a href={l.href} class="flex min-h-10 items-center text-text hover:text-brand">{l.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Services" class="lg:col-span-3">
        <h3 class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-brand">Services</h3>
        <ul class="mt-4 space-y-1">
          {FOOTER_SERVICES.map((l) => <li><a href={l.href} class="flex min-h-10 items-center text-text hover:text-brand">{l.label}</a></li>)}
          <li><a href="/services/" class="flex min-h-10 items-center font-semibold text-brand">All services →</a></li>
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <h3 class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-brand">Locations</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-4">
          {CLINICS.map((c) => <li><a href={`/locations/${c.slug}/`} class="flex min-h-10 items-center text-text hover:text-brand">{c.name}</a></li>)}
        </ul>
        <h3 class="mt-6 font-sans text-[0.75rem] font-semibold uppercase tracking-[0.2em] text-brand">Hours</h3>
        <ul class="mt-3 space-y-1 text-sm text-muted">
          {HOURS.map((h) => <li class="flex justify-between gap-4"><span>{h.day}</span><span>{h.time}</span></li>)}
          <li class="pt-1 text-xs">{HOURS_NOTE}</li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-ink/10 pt-8 text-sm text-muted md:flex-row md:items-center">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <div class="flex flex-wrap gap-x-6">
        <a href="/privacy-policy/" class="flex min-h-10 items-center hover:text-brand">Privacy Policy</a>
        <a href="/terms/" class="flex min-h-10 items-center hover:text-brand">Terms of Use</a>
        <a href={BOOK_URL} class="flex min-h-10 items-center hover:text-brand">Request Appointment</a>
      </div>
    </div>
  </div>
</footer>
