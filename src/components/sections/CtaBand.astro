---
import Reveal from '../islands/Reveal';
import { BOOK_URL, CLINICS, HOURS, HOURS_NOTE, PHONE, PHONE_HREF } from '../../data/content';

interface Props {
  eyebrow?: string;
  text?: string;
  secondary?: { label: string; href: string };
}
const { eyebrow = 'Ready when you are', text = 'Tell us what hurts, what you want to get back to and where you are. We will match you with the right therapist and the clinic closest to you.', secondary = { label: 'Meet the full team', href: '/staff/' } } = Astro.props;
const weekdays = HOURS[0];
---

<section class="on-blue relative isolate overflow-hidden bg-sky py-16 text-ink lg:py-24" aria-label="Book an appointment">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-32 -top-32 h-[28rem] w-[28rem] rounded-full bg-white/20 blur-3xl"></div>
    <div class="absolute -bottom-40 right-0 h-[30rem] w-[30rem] rounded-full bg-brand/20 blur-3xl"></div>
    <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-12 -right-10 w-[30rem] opacity-[.12] mix-blend-multiply" />
  </div>

  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="grid gap-7 lg:col-span-7">
      <Reveal client:visible><p class="eyebrow text-ink/80">{eyebrow}</p></Reveal>
      <Reveal client:visible delay={0.06}><h2 class="h-section max-w-2xl"><slot /></h2></Reveal>
      <Reveal client:visible delay={0.12}><p class="lead max-w-xl">{text}</p></Reveal>
      <Reveal client:visible delay={0.18} className="flex flex-wrap items-center gap-3">
        <a href={BOOK_URL} class="btn btn-gold">Request Appointment</a>
        <a href={secondary.href} class="btn btn-outline">{secondary.label}</a>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.15} className="lg:col-span-5">
      <ul role="list" class="grid divide-y divide-ink/10 overflow-hidden rounded-2xl border border-white/60 bg-white/70 shadow-[0_30px_60px_-34px_rgb(10_27_51/0.5)] backdrop-blur">
        <li>
          <a href={PHONE_HREF} class="group flex items-center gap-4 p-5 transition-colors hover:bg-white/70">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sky/40 text-brand" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            </span>
            <span><span class="block text-xs font-semibold uppercase tracking-[0.16em] text-muted">Call us</span><span class="block font-serif text-2xl text-ink">{PHONE}</span></span>
          </a>
        </li>
        <li class="flex items-center gap-4 p-5">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sky/40 text-brand" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </span>
          <span><span class="block text-xs font-semibold uppercase tracking-[0.16em] text-muted">Hours</span><span class="block text-[1.05rem] font-semibold text-ink">{weekdays.day}, {weekdays.time}</span><span class="block text-sm text-muted">{HOURS_NOTE}</span></span>
        </li>
        <li>
          <a href="/#locations" class="group flex items-center gap-4 p-5 transition-colors hover:bg-white/70">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sky/40 text-brand" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <span class="flex-1"><span class="block text-xs font-semibold uppercase tracking-[0.16em] text-muted">Locations</span><span class="block text-[1.05rem] font-semibold text-ink">{CLINICS.length} clinics across San Diego</span></span>
            <span class="text-brand transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </Reveal>
  </div>
</section>
