---
import Reveal from '../islands/Reveal';
import { media } from '../../data/media';

const stats = [
  { n: '8', l: 'clinics across San Diego' },
  { n: '1:1', l: 'weekly hands-on clinician mentorship' },
  { n: '3D', l: 'movement analysis, free for patients' },
  { n: '0', l: 'aides or techs handling your care' },
];
---

<section id="about" class="section relative overflow-hidden bg-paper">
  <div class="wrap grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
    <!-- Image collage -->
    <div class="lg:col-span-6">
      <Reveal client:visible>
        <div class="mx-auto max-w-[32rem] pb-5 pr-5 lg:mx-0">
          <div class="relative">
          <div class="absolute inset-0 translate-x-5 translate-y-5 rounded-[2rem] border border-sky" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-[2rem] bg-ink shadow-[0_40px_80px_-40px_rgb(10_27_51/0.55)]">
            <video
              data-about-video
              class="block aspect-[3/4] w-full object-cover"
              src="/videos/water-and-sports-about.mp4"
              poster="/images/about-video-poster.jpg"
              width="1080" height="1440"
              autoplay muted loop playsinline preload="metadata"
              aria-label="Water & Sports Physical Therapy: we measure, we treat, you are back."
            ></video>
          </div>
          </div>
        </div>
      </Reveal>
    </div>

    <!-- Copy -->
    <div class="lg:col-span-6">
      <Reveal client:visible><p class="eyebrow">About Water &amp; Sports</p></Reveal>
      <Reveal client:visible delay={0.08}>
        <h2 class="h-section mt-5">Healing with skilled hands, <em>and with water.</em></h2>
      </Reveal>
      <Reveal client:visible delay={0.16}>
        <div class="mt-7 space-y-5 lead">
          <p>
            We combine high-skilled, hands-on therapy with the power of water. Patients learn deep-water exercises and injury-specific land programs for quick pain relief and long-lasting results.
          </p>
          <p>
            We find the underlying cause of your pain and treat that, not just the symptoms. Our patient-centered, evidence-based care gets people better in far fewer visits than the national average.
          </p>
        </div>
      </Reveal>
      <Reveal client:visible delay={0.24}>
        <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10">
          {stats.map((s) => (
            <div class="group relative isolate overflow-hidden bg-paper p-5 md:p-6">
              <span class="absolute inset-0 -z-10 translate-y-full bg-sky transition-transform duration-500 ease-out group-hover:translate-y-0 motion-reduce:transition-none" aria-hidden="true"></span>
              <dt class="origin-left font-serif text-4xl text-brand transition-all duration-500 ease-out group-hover:-translate-y-1 group-hover:scale-105 group-hover:text-ink md:text-5xl motion-reduce:transition-none">{s.n}</dt>
              <dd class="mt-1 text-sm leading-snug text-muted transition-colors duration-500 group-hover:text-ink/85">{s.l}</dd>
              <span class="mt-3 block h-[2px] w-0 bg-ink/70 transition-all duration-500 ease-out group-hover:w-10 motion-reduce:transition-none" aria-hidden="true"></span>
            </div>
          ))}
        </dl>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-2">
          <a href="/why-wspt/" class="btn btn-ink">Why Choose WSPT</a>
          <a href="/staff/" class="link-arrow">
            Meet our team
            <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<script>
  // Play only while visible; respect reduced-motion (show the poster with controls instead).
  const v = document.querySelector<HTMLVideoElement>('[data-about-video]');
  if (v) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay'); v.pause(); v.controls = true;
    } else {
      new IntersectionObserver(([e]) => { e.isIntersecting ? v.play().catch(() => {}) : v.pause(); }, { threshold: 0.25 }).observe(v);
    }
  }
</script>
