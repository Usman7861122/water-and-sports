---
import Reveal from '../islands/Reveal';
interface Props { eyebrow: string; back?: { label: string; href: string } }
const { eyebrow, back = { label: 'Home', href: '/' } } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-mist/60 pb-14 pt-32 lg:pb-20 lg:pt-44">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -right-40 top-10 h-[34rem] w-[34rem] rounded-full bg-sky/25 blur-3xl"></div>
    <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-10 -left-16 w-[32rem] opacity-[.07]" />
  </div>
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class:list={[Astro.slots.has('aside') ? 'lg:col-span-7' : 'lg:col-span-9']}>
      <Reveal client:load><a href={back.href} class="link-arrow text-sm"><span aria-hidden="true">←</span> {back.label}</a></Reveal>
      <Reveal client:load delay={0.06}><p class="eyebrow mt-8">{eyebrow}</p></Reveal>
      <Reveal client:load delay={0.12}><h1 class="h-display mt-5"><slot name="title" /></h1></Reveal>
      <Reveal client:load delay={0.2}><p class="lead mt-6 max-w-2xl"><slot name="lead" /></p></Reveal>
      <Reveal client:load delay={0.28}><div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3"><slot name="actions" /></div></Reveal>
    </div>
    {Astro.slots.has('aside') && <div class="lg:col-span-5"><Reveal client:load delay={0.1}><slot name="aside" /></Reveal></div>}
  </div>
</section>
