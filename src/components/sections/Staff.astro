---
import Reveal from '../islands/Reveal';
import { STAFF_FEATURED } from '../../data/content';
---

<section id="staff" class="section relative overflow-hidden bg-mist/50" aria-labelledby="staff-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Reveal client:visible><p class="eyebrow">Our Staff</p></Reveal>
        <Reveal client:visible delay={0.08}>
          <h2 id="staff-title" class="h-section mt-5">The clinicians behind <em>your recovery.</em></h2>
        </Reveal>
      </div>
      <Reveal client:visible delay={0.16} className="lg:col-span-5">
        <p class="lead">Every visit is with a licensed physical therapist who knows your name, your goals and your sport. Meet the leaders guiding our eight clinics.</p>
      </Reveal>
    </div>

    <ul role="list" class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-7 lg:mt-16 lg:gap-y-14">
      {STAFF_FEATURED.map((m, i) => (
        <li>
          <Reveal client:visible delay={(i % 3) * 0.08}>
            <a href="/staff/" class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand" aria-label={`${m.name}, ${m.role}. See our full team.`}>
              <div class="relative overflow-hidden rounded-2xl bg-sand shadow-[0_24px_50px_-30px_rgb(10_27_51/0.45)]">
                <img
                  src={m.image}
                  alt={`Portrait of ${m.name}`}
                  width="800" height="960" loading="lazy" decoding="async"
                  class="aspect-[4/5] w-full object-cover object-top transition-transform duration-[900ms] ease-out group-hover:scale-105 motion-reduce:transition-none"
                />
                <span class="absolute inset-x-0 bottom-0 flex translate-y-full items-center justify-between bg-gradient-to-t from-ink/80 to-transparent px-5 pb-4 pt-10 text-sm font-semibold text-white transition-transform duration-500 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none" aria-hidden="true">
                  Meet the team
                  <svg width="18" height="12" viewBox="0 0 18 12"><path d="M1 6h15M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
              <div class="mt-5 flex items-start gap-3">
                <span class="mt-[0.7rem] h-1.5 w-1.5 shrink-0 rounded-full bg-sky transition-all duration-300 group-hover:scale-150 group-hover:bg-brand" aria-hidden="true"></span>
                <div>
                  <h3 class="font-serif text-xl leading-snug text-ink md:text-2xl">{m.name}</h3>
                  <p class="mt-0.5 text-sm font-medium text-brand">{m.role}</p>
                  <p class="mt-0.5 text-[0.8rem] tracking-wide text-muted">{m.creds}</p>
                </div>
              </div>
            </a>
          </Reveal>
        </li>
      ))}
    </ul>

    <Reveal client:visible delay={0.1}>
      <div class="mt-14 flex flex-col items-center gap-4 border-t border-ink/10 pt-10 text-center sm:flex-row sm:justify-between sm:text-left">
        <p class="font-serif text-xl text-ink md:text-2xl">Physical therapists, assistants and specialists, all in one team.</p>
        <a href="/staff/" class="btn btn-ink">Meet our full team</a>
      </div>
    </Reveal>
  </div>
</section>
