---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { EMAIL, PHONE, PHONE_HREF } from '../data/content';
import { FORMS, formMailto } from '../data/resources';
const icons: Record<string, string> = {
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/>',
  clipboard: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h4"/>',
  pulse: '<path d="M3 12h4l2-6 4 12 2-6h6"/>',
  check: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
};
const steps = [
  { t: 'Get the forms', d: 'Choose the forms you need below. We can email them to you or hand them to you at check-in.' },
  { t: 'Fill out completely', d: 'Print and complete all required fields. Please write clearly.' },
  { t: 'Bring them to your visit', d: `Bring completed forms to your first visit, or email them to ${EMAIL} in advance.` },
];
---
<BaseLayout solidHeader title="Patient Forms | Water & Sports Physical Therapy San Diego" description="New patient paperwork for Water & Sports Physical Therapy: intake, insurance verification, medical history, pain assessment, consent and HIPAA notice.">
  <PageHero eyebrow="Patient forms">
    <Fragment slot="title">Paperwork, <em>done early.</em></Fragment>
    <Fragment slot="lead">Complete these forms before your appointment to save time during check-in.</Fragment>
    <Fragment slot="actions"><a href="#forms" class="btn btn-ink">See the forms</a><a href={PHONE_HREF} class="link-arrow">Questions? Call {PHONE}</a></Fragment>
  </PageHero>

  <section id="forms" class="section bg-paper" aria-labelledby="forms-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">Your forms</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="forms-title" class="h-section mt-5 max-w-2xl">Six forms <em>for your first visit.</em></h2></Reveal>
      <ul role="list" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {FORMS.map((f, i) => (
          <li>
            <Reveal client:visible delay={(i % 3) * 0.07} className="h-full">
              <div class="flex h-full flex-col rounded-2xl border border-ink/10 bg-paper p-7 transition-all duration-500 hover:-translate-y-1.5 hover:border-sky hover:shadow-[0_30px_60px_-34px_rgb(10_27_51/0.45)]">
                <span class="grid h-12 w-12 place-items-center rounded-xl bg-mist text-brand" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} /></span>
                <h3 class="mt-5 font-serif text-2xl text-ink">{f.title}</h3>
                <p class="mt-2 flex-1 text-[0.97rem] leading-7 text-muted">{f.text}</p>
                {f.href
                  ? <a href={f.href} class="link-arrow mt-5 text-sm">Read the notice <span aria-hidden="true">→</span></a>
                  : f.file
                    ? <a href={f.file} download class="link-arrow mt-5 text-sm">Download PDF <span aria-hidden="true">↓</span></a>
                    : <a href={formMailto(f.title)} class="link-arrow mt-5 text-sm">Request this form <span aria-hidden="true">→</span></a>}
              </div>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist/50" aria-labelledby="how-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">How to submit your forms</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="how-title" class="h-section mt-5 max-w-2xl">Three simple steps <em>before you arrive.</em></h2></Reveal>
      <ol role="list" class="mt-12 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li>
            <Reveal client:visible delay={i * 0.07} className="h-full">
              <div class="h-full rounded-2xl border border-ink/10 bg-paper p-7">
                <span class="font-serif text-3xl text-sky">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 font-serif text-2xl text-ink">{s.t}</h3>
                <p class="mt-2 text-[0.98rem] leading-7 text-muted">{s.d}</p>
              </div>
            </Reveal>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-[0.98rem] leading-7 text-text">Please do not email medical details you are not comfortable sending. You can also bring everything to your visit, or call us at <a href={PHONE_HREF} class="font-semibold text-brand underline underline-offset-4">{PHONE}</a>.</p>
    </div>
  </section>

  <CtaBand eyebrow="Patient forms" text="Our staff is happy to walk you through any form, by phone or at the front desk." secondary={{ label: 'Insurance we accept', href: '/insurance/' }}>Ready for your <em>first visit?</em></CtaBand>
</BaseLayout>
