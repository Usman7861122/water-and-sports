---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import CareerForm from '../components/islands/CareerForm';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { EMAIL } from '../data/content';
import { JOBS, PERKS } from '../data/resources';
import { REAL } from '../data/real';
const events = ['Harbor cruises', 'Team-building events', 'Staff celebrations', 'Community activities', 'Collaborative environment'];
---
<BaseLayout solidHeader title="Careers | Join the Team at Water & Sports Physical Therapy San Diego" description="Physical therapist and PTA jobs in San Diego. Join a collaborative team in sports and orthopedic rehab with continuing education and career growth.">
  <PageHero eyebrow="Employment">
    <Fragment slot="title">Join the team <em>at WSPT.</em></Fragment>
    <Fragment slot="lead">Join a collaborative team helping athletes, active adults, orthopedic patients, and families throughout San Diego move better, recover stronger, and live healthier.</Fragment>
    <Fragment slot="actions"><a href="#openings" class="btn btn-ink">See open positions</a><a href="#apply" class="link-arrow">Apply now</a></Fragment>
    <Fragment slot="aside"><div class="overflow-hidden rounded-[1.5rem] bg-sand shadow-[0_40px_80px_-40px_rgb(10_27_51/0.55)]"><img src={REAL.team.src} alt={REAL.team.alt} width={REAL.team.w} height={REAL.team.h} fetchpriority="high" decoding="async" class="aspect-[4/3] w-full object-cover" /></div></Fragment>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="diff-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal client:visible><p class="eyebrow">What makes WSPT different</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="diff-title" class="h-section mt-5">Recovery should be <em>active, not passive.</em></h2></Reveal>
      </div>
      <div class="lg:col-span-7"><Reveal client:visible><p class="lead">Our treatment philosophy centers on empowering you with the knowledge and tools to take control of your healing process. We offer competitive compensation, comprehensive benefits, and an environment designed to help you thrive professionally and personally.</p></Reveal></div>
    </div>
    <div class="wrap mt-12">
      <p class="eyebrow">Why work at WSPT?</p>
      <ul role="list" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {PERKS.map((p, i) => (
          <li>
            <Reveal client:visible delay={(i % 4) * 0.05} className="h-full">
              <div class="h-full rounded-2xl border border-ink/10 bg-paper p-6 transition-all duration-500 hover:-translate-y-1 hover:border-sky">
                <span class="font-serif text-2xl text-sky">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-2 font-serif text-xl text-ink">{p.t}</h3>
                <p class="mt-2 text-[0.95rem] leading-7 text-muted">{p.d}</p>
              </div>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist/50" aria-labelledby="ce-title">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <Reveal client:visible><div class="overflow-hidden rounded-[1.5rem] bg-sand"><img src="/images/why/why-wspt-2.webp" alt="Clinicians learning a hands-on technique together" width="1600" height="1067" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" /></div></Reveal>
      </div>
      <div class="lg:col-span-6">
        <Reveal client:visible><p class="eyebrow">Continuing education &amp; career growth</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="ce-title" class="h-section mt-5">Always learning. <em>Always growing.</em></h2></Reveal>
        <div class="mt-6 grid gap-4 text-[1.02rem] leading-8 text-text">
          <Reveal client:visible delay={0.1}><p>WSPT is committed to helping clinicians continue learning, growing, and advancing throughout their careers. At WSPT, professional development is built into our culture. Our therapists take part in monthly physical therapy training sessions, hands-on clinical instruction, and collaborative learning designed to improve patient outcomes and expand clinical expertise.</p></Reveal>
          <Reveal client:visible delay={0.14}><p>From orthopedic rehabilitation and manual therapy techniques to sports performance and aquatic therapy strategies, our team keeps building new skills. Investing in our clinicians leads to better care for our patients and stronger long-term career growth for our team.</p></Reveal>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="culture-title">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6 lg:order-2">
        <Reveal client:visible><div class="overflow-hidden rounded-[1.5rem] bg-sand"><img src="/images/why/why-wspt-3.webp" alt="The WSPT team together at a clinic" width="1600" height="1067" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" /></div></Reveal>
      </div>
      <div class="lg:col-span-6">
        <Reveal client:visible><p class="eyebrow">Our culture</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="culture-title" class="h-section mt-5">A team that works hard — <em>and enjoys time together.</em></h2></Reveal>
        <Reveal client:visible delay={0.12}><p class="mt-6 text-[1.02rem] leading-8 text-text">Team culture matters. Beyond patient care, we make time to connect, celebrate successes, and build strong relationships throughout the year. We believe a positive workplace creates a stronger experience for both employees and patients.</p></Reveal>
        <Reveal client:visible delay={0.16}><ul role="list" class="creds mt-6">{events.map((e) => <li class="cred !normal-case !tracking-[0.04em]">{e}</li>)}</ul></Reveal>
      </div>
    </div>
  </section>

  <section id="openings" class="section bg-mist/50 scroll-mt-24" aria-labelledby="jobs-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">Open positions</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="jobs-title" class="h-section mt-5 max-w-2xl">Ready to take the <em>next step in your career?</em></h2></Reveal>
      <ul role="list" class="mt-10 grid gap-6 md:grid-cols-2">
        {JOBS.map((j, i) => (
          <li>
            <Reveal client:visible delay={i * 0.07} className="h-full">
              <div class="flex h-full flex-col rounded-2xl border border-ink/10 bg-paper p-7">
                <h3 class="font-serif text-2xl text-ink">{j.title}</h3>
                <p class="mt-2 text-[0.98rem] leading-7 text-text">{j.text}</p>
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-brand">Qualifications</p>
                <p class="mt-1 flex-1 text-[0.95rem] leading-7 text-muted">{j.qual}</p>
                <a href="#apply" class="btn btn-ink mt-6 self-start">Apply now</a>
              </div>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="apply" class="section bg-paper scroll-mt-24" aria-labelledby="apply-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <Reveal client:visible><p class="eyebrow">Submit your application</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="apply-title" class="h-section mt-5">We look forward to <em>meeting you.</em></h2></Reveal>
        <Reveal client:visible delay={0.14}><p class="mt-5 text-[1.02rem] leading-8 text-text">Fill out the form to apply for an open position. We look forward to reviewing your qualifications.</p></Reveal>
      </div>
      <div class="lg:col-span-8"><CareerForm client:visible email={EMAIL} /></div>
    </div>
  </section>

  <CtaBand eyebrow="Employment" text="Not sure which role fits? Send us a note and we will be in touch." secondary={{ label: 'Meet our team', href: '/staff/' }}>Build your career <em>in San Diego.</em></CtaBand>
</BaseLayout>
