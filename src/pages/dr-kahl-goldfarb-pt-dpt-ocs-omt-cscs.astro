---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import CtaBand from '../components/sections/CtaBand.astro';
import { BOOK_URL, CLINICS, PHONE, PHONE_HREF } from '../data/content';
import { GOLDFARB as g } from '../data/staff';
---

<BaseLayout
  solidHeader
  title="Dr. Kahl Goldfarb, PT, DPT, OCS, OMT, CSCS | Founder & CEO | Water & Sports Physical Therapy"
  description="Dr. Kahl Goldfarb is the Founder and CEO of Water & Sports Physical Therapy in San Diego, a board-certified orthopaedic specialist and former Head Physical Therapist of the San Diego Padres."
>
  <!-- Intro -->
  <section class="relative isolate overflow-hidden bg-mist/60 pb-16 pt-32 lg:pb-24 lg:pt-44">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-40 top-10 h-[34rem] w-[34rem] rounded-full bg-sky/25 blur-3xl"></div>
      <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-10 -left-16 w-[32rem] opacity-[.07]" />
    </div>
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal client:load>
          <div class="relative mx-auto max-w-md lg:mx-0">
            <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-[2rem] border border-sky" aria-hidden="true"></div>
            <div class="relative overflow-hidden rounded-[2rem] bg-sand shadow-[0_40px_80px_-40px_rgb(10_27_51/0.55)]">
              <img src={g.image} alt={`Portrait of ${g.name}`} width="1600" height="1607" fetchpriority="high" decoding="async" class="aspect-[4/5] w-full object-cover object-top" />
            </div>
          </div>
        </Reveal>
      </div>

      <div class="lg:col-span-7">
        <Reveal client:load>
          <a href="/staff/" class="link-arrow text-sm"><span aria-hidden="true">←</span> Our Staff</a>
        </Reveal>
        <Reveal client:load delay={0.06}><p class="eyebrow mt-8">{g.role}</p></Reveal>
        <Reveal client:load delay={0.12}>
          <h1 class="h-display mt-5">{g.name}<span class="creds mt-5">{g.creds.split(', ').map((c) => <span class="cred">{c}</span>)}</span></h1>
        </Reveal>
        <Reveal client:load delay={0.2}><p class="lead mt-7 max-w-2xl">{g.tagline}</p></Reveal>
        <Reveal client:load delay={0.28}>
          <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10 sm:grid-cols-4">
            {g.stats.map((s) => (
              <div class="group relative bg-paper p-5 transition-colors duration-300 hover:bg-mist">
                <dt class="font-serif text-3xl text-brand transition-transform duration-300 ease-out group-hover:-translate-y-1 md:text-4xl">{s.n}</dt>
                <dd class="mt-1 text-[0.8rem] leading-snug text-muted transition-colors duration-300 group-hover:text-ink">{s.l}</dd>
                <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-sky transition-transform duration-500 ease-out group-hover:scale-x-100 motion-reduce:transition-none" aria-hidden="true"></span>
              </div>
            ))}
          </dl>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={BOOK_URL} class="btn btn-ink">Request Appointment</a>
            <a href={PHONE_HREF} class="link-arrow">Call {PHONE}</a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Biography -->
  <section class="section bg-paper" aria-label="Biography">
    <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="grid content-start gap-14 lg:col-span-8">
        {g.sections.map((s) => (
          <Reveal client:visible>
            <article>
              <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">{s.title}</h2>
              <div class="mt-5 max-w-3xl space-y-5 text-[1.05rem] leading-8 text-text">
                {s.paras.map((p) => <p>{p}</p>)}
              </div>
            </article>
          </Reveal>
        ))}
      </div>

      <aside class="lg:col-span-4" aria-label="At a glance">
        <div class="grid gap-8 lg:sticky lg:top-32">
          <Reveal client:visible>
            <div class="rounded-2xl border border-ink/10 bg-mist/50 p-7">
              <h2 class="font-serif text-2xl text-ink">Specialties</h2>
              <ul class="mt-4 space-y-3">
                {g.specialties.map((x) => (
                  <li class="flex gap-3 text-[0.95rem] leading-snug text-text"><span class="mt-[0.5rem] h-1.5 w-1.5 shrink-0 rounded-full bg-sky" aria-hidden="true"></span>{x}</li>
                ))}
              </ul>
            </div>
          </Reveal>
          <Reveal client:visible delay={0.1}>
            <div class="rounded-2xl border border-ink/10 bg-paper p-7 shadow-[0_24px_50px_-35px_rgb(10_27_51/0.4)]">
              <h2 class="font-serif text-2xl text-ink">Career highlights</h2>
              <ul class="mt-4 space-y-3">
                {g.highlights.map((x) => (
                  <li class="flex gap-3 text-[0.95rem] leading-snug text-text"><span class="mt-[0.5rem] h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>{x}</li>
                ))}
              </ul>
            </div>
          </Reveal>
        </div>
      </aside>
    </div>
  </section>

  <!-- Areas of expertise + athletes -->
  <section class="section relative overflow-hidden bg-mist/50" aria-labelledby="expertise-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">Areas of expertise</p></Reveal>
      <Reveal client:visible delay={0.08}>
        <h2 id="expertise-title" class="h-section mt-5 max-w-3xl">Where his work <em>makes the difference.</em></h2>
      </Reveal>
      <Reveal client:visible delay={0.16}>
        <ul class="mt-10 flex flex-wrap gap-3" role="list">
          {g.expertise.map((x) => (
            <li class="rounded-lg border border-ink/10 bg-paper px-4 py-2.5 text-[0.95rem] text-ink transition-colors duration-300 hover:border-sky hover:bg-sky/20">{x}</li>
          ))}
        </ul>
      </Reveal>

      <div class="mt-20 border-t border-ink/10 pt-14">
        <Reveal client:visible><h3 class="font-serif text-2xl text-ink md:text-3xl">Athletes he has had the privilege of treating</h3></Reveal>
        <ul role="list" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {g.athletes.map((a, i) => (
            <li>
              <Reveal client:visible delay={(i % 4) * 0.06} className="h-full">
                <div class="group h-full rounded-2xl border border-ink/10 bg-paper p-6 transition-all duration-500 hover:-translate-y-1 hover:border-sky hover:shadow-[0_24px_50px_-30px_rgb(10_27_51/0.45)]">
                  <span class="block h-px w-8 bg-sky transition-all duration-500 group-hover:w-14" aria-hidden="true"></span>
                  <p class="mt-4 font-serif text-xl text-ink">{a.name}</p>
                  <p class="mt-1 text-sm leading-snug text-muted">{a.note}</p>
                </div>
              </Reveal>
            </li>
          ))}
          <li class="hidden lg:block">
            <Reveal client:visible delay={0.24}>
              <div class="flex h-full flex-col justify-center rounded-2xl bg-sky p-6 text-ink">
                <p class="font-serif text-xl leading-snug">…and every athlete who walks through our doors.</p>
              </div>
            </Reveal>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section id="locations" class="section bg-paper" aria-labelledby="where-title">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Reveal client:visible><p class="eyebrow">Where Dr. Goldfarb serves</p></Reveal>
          <Reveal client:visible delay={0.08}>
            <h2 id="where-title" class="h-section mt-5">Eight clinics, <em>one standard of care.</em></h2>
          </Reveal>
        </div>
        <Reveal client:visible delay={0.16} className="lg:col-span-5">
          <p class="lead">Dr. Goldfarb founded Water &amp; Sports with a single clinic in Mission Beach. Today he leads eight San Diego locations that share the same hands-on, evidence-based approach.</p>
        </Reveal>
      </div>

      <ul role="list" class="mt-12 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
        {CLINICS.map((c, i) => (
          <li>
            <Reveal client:visible delay={(i % 4) * 0.07} className="h-full">
              <a href={`/locations/${c.slug}/`} class="group block h-full overflow-hidden rounded-2xl border border-ink/10 bg-paper transition-all duration-500 hover:-translate-y-1.5 hover:border-sky hover:shadow-[0_30px_60px_-30px_rgb(10_27_51/0.5)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand">
                <div class="relative overflow-hidden bg-sand">
                  <img src={c.image} alt={`${c.name} clinic`} width="600" height="450" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-105 motion-reduce:transition-none" />
                  {c.slug === 'mission-beach' && (
                    <span class="absolute left-3 top-3 rounded-md bg-white/95 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-brand shadow">Where it began</span>
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-serif text-xl text-ink">{c.name}</h3>
                  <p class="mt-1 text-sm leading-snug text-muted">{c.address.split(',')[0]}{c.note ? ` · ${c.note}` : ''}</p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">View clinic
                    <svg width="16" height="10" viewBox="0 0 18 12" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M1 6h15M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </a>
            </Reveal>
          </li>
        ))}
      </ul>
      <Reveal client:visible delay={0.1}>
        <p class="mt-10 text-center sm:text-left"><a href="/locations/" class="link-arrow">See all locations <span aria-hidden="true">→</span></a></p>
      </Reveal>
    </div>
  </section>

  <!-- CTA -->
  <CtaBand>Recover, train and perform with <em>Dr. Goldfarb’s team.</em></CtaBand>
</BaseLayout>
