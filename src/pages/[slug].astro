---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import CtaBand from '../components/sections/CtaBand.astro';
import { BOOK_URL, CLINICS, PHONE, PHONE_HREF } from '../data/content';
import { TEAM, type Member } from '../data/team';

export function getStaticPaths() {
  return TEAM.map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

const { member } = Astro.props as { member: Member };
const first = member.name.replace(/^Dr\.\s*/, '').replace(/[“”].*?[“”]\s*/, '').split(' ')[0];
const short = member.name.startsWith('Dr.') ? `Dr. ${first}` : first;
const clinics = CLINICS.filter((c) => member.clinics.includes(c.slug));
const related = TEAM.filter((t) => t.group === member.group && t.slug !== member.slug).slice(0, 4);
const initials = member.name.replace(/^Dr\.\s*/, '').replace(/[“”"]/g, '').split(/\s+/).slice(0, 2).map((w) => w[0]).join('');
const bio = member.bio.length
  ? member.bio
  : [
      `${member.name} is part of the Water & Sports Physical Therapy team in San Diego${clinics.length ? `, leading our ${clinics.map((c) => c.name).join(' and ')} ${clinics.length > 1 ? 'clinics' : 'clinic'}` : ''}. ${short} works with patients to reduce pain, restore movement and get back to the activities they love.`,
    ];
---

<BaseLayout
  solidHeader
  title={`${member.name}, ${member.creds} | ${member.role} | Water & Sports Physical Therapy`}
  description={`Meet ${member.name}, ${member.role} at Water & Sports Physical Therapy in San Diego.`}
>
  <section class="relative isolate overflow-hidden bg-mist/60 pb-16 pt-32 lg:pb-24 lg:pt-44">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-40 top-10 h-[34rem] w-[34rem] rounded-full bg-sky/25 blur-3xl"></div>
      <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-10 -left-16 w-[32rem] opacity-[.07]" />
    </div>
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal client:load>
          <div class="relative mx-auto max-w-md lg:mx-0">
            <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-[2rem] border border-sky" aria-hidden="true"></div>
            <div class="relative overflow-hidden rounded-[2rem] bg-sand shadow-[0_40px_80px_-40px_rgb(10_27_51/0.55)]">
              {member.image ? (
                <img src={member.image} alt={`Portrait of ${member.name}`} width="800" height="1000" fetchpriority="high" decoding="async" class="aspect-[4/5] w-full object-cover object-top" />
              ) : (
                <div class="grid aspect-[4/5] w-full place-items-center bg-gradient-to-br from-mist to-sky/50 font-serif text-8xl text-brand" aria-hidden="true">{initials}</div>
              )}
            </div>
          </div>
        </Reveal>
      </div>

      <div class="lg:col-span-7">
        <Reveal client:load><a href="/staff/" class="link-arrow text-sm"><span aria-hidden="true">←</span> Our Staff</a></Reveal>
        <Reveal client:load delay={0.06}><p class="eyebrow mt-8">{member.role}</p></Reveal>
        <Reveal client:load delay={0.12}>
          <h1 class="h-display mt-5">{member.name}<span class="mt-3 block font-sans text-[0.9rem] font-semibold uppercase tracking-[0.2em] text-brand">{member.creds}</span></h1>
        </Reveal>
        <Reveal client:load delay={0.2}><p class="lead mt-7 max-w-2xl">{bio[0]}</p></Reveal>
        <Reveal client:load delay={0.28}>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={BOOK_URL} class="btn btn-ink">Request Appointment</a>
            <a href={PHONE_HREF} class="link-arrow">Call {PHONE}</a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {member.bio.length > 1 && (
    <section class="section bg-paper" aria-label="Biography">
      <div class="wrap">
        <Reveal client:visible>
          <div class="mx-auto max-w-3xl">
            <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">About {short}</h2>
            <div class="mt-6 space-y-5 text-[1.05rem] leading-8 text-text">
              {member.bio.slice(1).map((p) => <p>{p}</p>)}
            </div>
          </div>
        </Reveal>
      </div>
    </section>
  )}

  {clinics.length > 0 && (
    <section class="section bg-mist/50" aria-labelledby="leads-title">
      <div class="wrap">
        <Reveal client:visible><p class="eyebrow">Where {short} leads</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="leads-title" class="h-section mt-5">{clinics.length > 1 ? 'Clinics' : 'Clinic'} <em>led by {short}.</em></h2></Reveal>
        <ul role="list" class="mt-12 grid gap-6 sm:grid-cols-2 lg:max-w-3xl">
          {clinics.map((c) => (
            <li>
              <a href={`/locations/${c.slug}/`} class="group block h-full overflow-hidden rounded-2xl border border-ink/10 bg-paper transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_30px_60px_-34px_rgb(10_27_51/0.45)]">
                <div class="overflow-hidden bg-sand"><img src={c.image} alt={`${c.name} clinic`} width="600" height="450" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
                <div class="p-5"><h3 class="font-serif text-xl text-ink">{c.name}</h3><p class="mt-1 text-sm text-muted">{c.address}</p><span class="link-arrow mt-2 text-sm">View clinic <span aria-hidden="true">→</span></span></div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section bg-paper" aria-labelledby="more-title">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="more-title" class="h-section">Meet more of <em>the team.</em></h2>
        <a href="/staff/" class="link-arrow">See everyone <span aria-hidden="true">→</span></a>
      </div>
      <ul role="list" class="team-grid cols-4 mt-10">
        {related.map((t) => (
          <li>
            <a href={`/${t.slug}/`} class="group block">
              <div class="overflow-hidden rounded-2xl bg-mist">
                {t.image ? <img src={t.image} alt={`Portrait of ${t.name}`} loading="lazy" decoding="async" width="600" height="750" class="aspect-[4/5] w-full object-cover object-top transition duration-700 group-hover:scale-[1.04]" /> : <div class="grid aspect-[4/5] place-items-center bg-gradient-to-br from-mist to-sky/40 font-serif text-5xl text-brand" aria-hidden="true">{t.name.replace(/^Dr\.\s*/, '').split(' ').slice(0, 2).map((w) => w[0]).join('')}</div>}
              </div>
              <h3 class="mt-4 font-serif text-lg text-ink">{t.name}</h3>
              <p class="text-sm text-muted">{t.role}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand secondary={{ label: 'Meet the full team', href: '/staff/' }}>Book with <em>{short}</em> and the WSPT team.</CtaBand>
</BaseLayout>
