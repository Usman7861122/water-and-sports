---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/islands/Reveal';
import CtaBand from '../../components/sections/CtaBand.astro';
import { BOOK_URL, CLINICS } from '../../data/content';
import { CLINIC_AREAS, CLINIC_EXTRA } from '../../data/clinicPages';
---

<BaseLayout
  solidHeader
  title="Our Locations | Water & Sports Physical Therapy San Diego"
  description="Eight physical therapy clinics across San Diego: Carmel Valley, Coronado, Downtown, Pacific Beach, Mission Beach, Poway, Scripps Ranch and UTC."
>
  <section class="relative isolate overflow-hidden bg-mist/60 pb-14 pt-32 lg:pb-20 lg:pt-44">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-40 top-0 h-[32rem] w-[32rem] rounded-full bg-sky/25 blur-3xl"></div>
      <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-10 -left-16 w-[30rem] opacity-[.07]" />
    </div>
    <div class="wrap text-center">
      <Reveal client:load><p class="eyebrow justify-center">Our Locations</p></Reveal>
      <Reveal client:load delay={0.08}><h1 class="h-display mx-auto mt-5 max-w-3xl">Eight clinics, <em>one standard of care.</em></h1></Reveal>
      <Reveal client:load delay={0.16}><p class="lead mx-auto mt-6 max-w-2xl">From the beaches of Mission Beach to Poway and Scripps Ranch, find the Water &amp; Sports clinic closest to you.</p></Reveal>
      <Reveal client:load delay={0.22}><div class="mt-8 flex justify-center"><a href={BOOK_URL} class="btn btn-ink">Request Appointment</a></div></Reveal>
    </div>
  </section>

  <section class="section bg-paper" aria-label="All clinics">
    <div class="wrap">
      <ul role="list" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {CLINICS.map((c, i) => {
          const area = CLINIC_AREAS[c.slug];
          const tagline = CLINIC_EXTRA[c.slug]?.tagline ?? c.tagline;
          return (
            <li>
              <Reveal client:visible delay={(i % 4) * 0.07} className="h-full">
                <a href={`/locations/${c.slug}/`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-ink/10 bg-paper transition-all duration-500 hover:-translate-y-1.5 hover:border-sky hover:shadow-[0_30px_60px_-34px_rgb(10_27_51/0.45)]">
                  <div class="relative overflow-hidden bg-sand">
                    <img src={c.image} alt={`${c.name} clinic`} width="600" height="450" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    {c.slug === 'mission-beach' && <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-brand">Where it began</span>}
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <h2 class="font-serif text-2xl text-ink">{c.name}</h2>
                    <p class="mt-2 text-[0.95rem] leading-6 text-muted">{tagline}</p>
                    <dl class="mt-5 grid gap-2 text-sm text-ink">
                      <div class="flex gap-2"><dt class="sr-only">Address</dt><svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg><dd>{c.address}</dd></div>
                      <div class="flex gap-2"><dt class="sr-only">Hours</dt><svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><dd>{c.hours[0]}</dd></div>
                      <div class="flex gap-2"><dt class="sr-only">Phone</dt><svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><dd>(858) 488-3597 ext. {c.ext}</dd></div>
                    </dl>
                    {area && <p class="mt-4 border-t border-ink/10 pt-4 text-xs leading-5 text-muted">Serving {area.places.slice(0, 4).join(', ')} and nearby.</p>}
                    <span class="link-arrow mt-auto pt-5 text-sm">View clinic <span aria-hidden="true">→</span></span>
                  </div>
                </a>
              </Reveal>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <CtaBand eyebrow="Not sure which clinic?" secondary={{ label: 'Meet the team', href: '/staff/' }}>We will help you <em>find the right fit.</em></CtaBand>
</BaseLayout>
