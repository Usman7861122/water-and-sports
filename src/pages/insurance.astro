---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import InsuranceSearch from '../components/islands/InsuranceSearch';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { BOOK_URL, PHONE, PHONE_HREF } from '../data/content';
import { INSURANCE_FAQS, INSURANCE_HELP, PROVIDERS } from '../data/resources';
---
<BaseLayout solidHeader title="Insurance We Accept | Water & Sports Physical Therapy San Diego" description="We work with most major insurance plans across San Diego County, including Medicare, TRICARE and workers’ compensation. Search the full list.">
  <PageHero eyebrow="Insurance">
    <Fragment slot="title">Insurance coverage <em>made simple.</em></Fragment>
    <Fragment slot="lead">We work with major insurance providers across San Diego County to make quality physical therapy accessible and affordable.</Fragment>
    <Fragment slot="actions"><a href={PHONE_HREF} class="btn btn-ink">Verify benefits: {PHONE}</a><a href={BOOK_URL} class="link-arrow">Request appointment</a></Fragment>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="help-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal client:visible><p class="eyebrow">We accept most major plans</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="help-title" class="h-section mt-5">Care without <em>financial barriers.</em></h2></Reveal>
        <Reveal client:visible delay={0.14}><p class="lead mt-5">We are committed to making quality care accessible. We work with most major insurance providers so you can get the treatment you need.</p></Reveal>
      </div>
      <div class="lg:col-span-7">
        <Reveal client:visible><p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand">Our staff can help you with</p></Reveal>
        <ul role="list" class="mt-5 grid gap-3">
          {INSURANCE_HELP.map((h, i) => (
            <li>
              <Reveal client:visible delay={i * 0.05}>
                <div class="flex items-start gap-4 rounded-2xl border border-ink/10 bg-paper p-5">
                  <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-mist text-brand" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
                  <p class="text-[1.02rem] leading-7 text-ink">{h}</p>
                </div>
              </Reveal>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-[0.98rem] leading-7 text-text">If you don’t see your insurance provider listed, please contact our office. Insurance networks change frequently, and we may still be able to work with your plan or offer flexible payment options.</p>
      </div>
    </div>
  </section>

  <section class="section bg-mist/50" aria-labelledby="list-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">In-network insurance providers</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="list-title" class="h-section mt-5 max-w-2xl">Plans and workers’ compensation carriers <em>we accept.</em></h2></Reveal>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-muted">Coverage varies by individual plan. Please contact our office to verify participation and benefits.</p>
      <div class="mt-9"><InsuranceSearch client:visible providers={PROVIDERS} phone={PHONE} phoneHref={PHONE_HREF} /></div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="faq-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <Reveal client:visible><p class="eyebrow">Good to know</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="faq-title" class="h-section mt-5">Frequently asked <em>questions.</em></h2></Reveal>
      </div>
      <div class="grid content-start gap-3 lg:col-span-8">
        {INSURANCE_FAQS.map((f, i) => (
          <details class="group rounded-2xl border border-ink/10 bg-paper px-6 transition-colors open:border-sky open:bg-white" open={i === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-serif text-xl text-ink [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-ink/15 text-brand transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
            </summary>
            <div class="pb-6 pr-10 text-[1.02rem] leading-8 text-text"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="Insurance" text="Call us with your insurance details and we will check your coverage before your first visit." secondary={{ label: 'Find a clinic', href: '/locations/' }}>Questions about <em>your coverage?</em></CtaBand>
</BaseLayout>
