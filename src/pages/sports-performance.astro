---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import CtaBand from '../components/sections/CtaBand.astro';
import { BOOK_URL, CLINICS, PHONE, PHONE_HREF, SERVICES_ALL } from '../data/content';
import { SERVICE_PAGES } from '../data/services';
import { REAL } from '../data/real';

const SLUGS = ['running-analysis', 'performance-training', 'return-to-sport-testing', 'golf-rehabilitation', 'pickleball-injury-rehabilitation', 'shockwave-therapy'];
const items = SLUGS.map((slug) => {
  const page = SERVICE_PAGES[slug];
  const base = SERVICES_ALL.find((s) => s.href === `/${slug}/`);
  return { slug, title: page.title, text: base?.text ?? page.lead, eyebrow: page.eyebrow, image: page.images[0] };
});
const mosaic = [{ src: REAL.team.src, alt: REAL.team.alt }, SERVICE_PAGES['golf-rehabilitation'].images[0], SERVICE_PAGES['pickleball-injury-rehabilitation'].images[0]];
const steps = [
  { t: 'We assess how you move', d: 'Every plan starts with a hands-on evaluation and movement testing, not a guess.' },
  { t: 'You get a plan for your sport', d: 'Treatment and training are built around your injury, your sport and your goals.' },
  { t: 'We prove you are ready', d: 'Objective tests show when you can return to play, so you go back with confidence.' },
];
const faqs = [
  { q: 'Do I need to be a competitive athlete?', a: 'No. Our sports and performance care is for anyone who is active, from weekend runners and golfers to pickleball players and competitive athletes.' },
  { q: 'Do I need a doctor’s referral?', a: 'Please call us at ' + PHONE + ' and we will confirm what your plan needs before your first visit.' },
  { q: 'Can I get these services at any clinic?', a: `Yes. Every service on this page is offered at all ${CLINICS.length} of our San Diego clinics.` },
];
---

<BaseLayout solidHeader title="Sports & Performance Physical Therapy San Diego | Water & Sports Physical Therapy" description="Sports and performance physical therapy in San Diego: running analysis, performance training, return-to-sport testing, golf and pickleball rehab, and shockwave therapy.">
  <section class="relative isolate overflow-hidden bg-mist/60 pb-16 pt-32 lg:pb-24 lg:pt-44">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-40 top-10 h-[34rem] w-[34rem] rounded-full bg-sky/25 blur-3xl"></div>
      <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-10 -left-16 w-[32rem] opacity-[.07]" />
    </div>
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <Reveal client:load><a href="/#services" class="link-arrow text-sm"><span aria-hidden="true">←</span> All services</a></Reveal>
        <Reveal client:load delay={0.06}><p class="eyebrow mt-8">Sports &amp; performance</p></Reveal>
        <Reveal client:load delay={0.12}><h1 class="h-display mt-5">Move better. <em>Play longer.</em></h1></Reveal>
        <Reveal client:load delay={0.2}><p class="lead mt-6 max-w-xl">From your first run to your return to competition, our licensed therapists help active people recover, perform and stay injury-free.</p></Reveal>
        <Reveal client:load delay={0.26}>
          <ul role="list" class="creds mt-7">
            {items.map((i) => <li class="cred !normal-case !tracking-[0.04em]">{i.title}</li>)}
          </ul>
        </Reveal>
        <Reveal client:load delay={0.32}>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={BOOK_URL} class="btn btn-ink">Request Appointment</a>
            <a href={PHONE_HREF} class="link-arrow">Call {PHONE}</a>
          </div>
        </Reveal>
      </div>
      <div class="lg:col-span-6">
        <Reveal client:load delay={0.1}>
          <div class="mx-auto grid max-w-xl grid-cols-5 grid-rows-2 gap-3 lg:mr-0">
            <div class="col-span-3 row-span-2 overflow-hidden rounded-[1.5rem] bg-sand shadow-[0_40px_80px_-40px_rgb(10_27_51/0.55)]"><img src={mosaic[0].src} alt={mosaic[0].alt} width="2000" height="1125" fetchpriority="high" decoding="async" class="h-full min-h-[22rem] w-full object-cover" /></div>
            <div class="col-span-2 overflow-hidden rounded-[1.5rem] bg-sand"><img src={mosaic[1].src} alt={mosaic[1].alt} width="2000" height="1333" decoding="async" class="h-full w-full object-cover" /></div>
            <div class="col-span-2 overflow-hidden rounded-[1.5rem] bg-sand"><img src={mosaic[2].src} alt={mosaic[2].alt} width="2000" height="1333" decoding="async" class="h-full w-full object-cover" /></div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="svc-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">Our services</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="svc-title" class="h-section mt-5 max-w-2xl">Six ways we help you <em>perform at your best.</em></h2></Reveal>
      <ul role="list" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {items.map((s, i) => (
          <li>
            <Reveal client:visible delay={(i % 3) * 0.07} className="h-full">
              <a href={`/${s.slug}/`} class="group block h-full overflow-hidden rounded-2xl border border-ink/10 bg-paper transition-all duration-500 hover:-translate-y-1.5 hover:border-sky hover:shadow-[0_30px_60px_-34px_rgb(10_27_51/0.45)]">
                <div class="overflow-hidden bg-sand"><img src={s.image.src} alt={s.image.alt} width="2000" height="1333" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
                <div class="p-6">
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand">{s.eyebrow}</p>
                  <h3 class="mt-2 font-serif text-2xl text-ink">{s.title}</h3>
                  <p class="mt-2 text-[0.95rem] leading-7 text-muted">{s.text}</p>
                  <span class="link-arrow mt-4 text-sm">Learn more <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist/50" aria-labelledby="how-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">How it works</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="how-title" class="h-section mt-5 max-w-2xl">One clear path from <em>injury to peak form.</em></h2></Reveal>
      <ol role="list" class="mt-12 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li>
            <Reveal client:visible delay={i * 0.07} className="h-full">
              <div class="h-full rounded-2xl border border-ink/10 bg-paper p-7">
                <span class="font-serif text-3xl text-sky">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 font-serif text-2xl text-ink">{s.t}</h3>
                <p class="mt-2 text-[0.98rem] leading-7 text-muted">{s.d}</p>
              </div>
            </Reveal>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="where-title">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">Where to find us</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 id="where-title" class="h-section mt-5">At all <em>{CLINICS.length} San Diego clinics.</em></h2></Reveal>
      <ul role="list" class="mt-10 flex flex-wrap gap-3">
        {CLINICS.map((c) => (
          <li><a href={`/locations/${c.slug}/`} class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-ink/10 bg-paper px-4 text-[0.95rem] text-ink transition-all duration-300 hover:-translate-y-0.5 hover:border-sky hover:bg-sky/25"><svg viewBox="0 0 24 24" class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist/50" aria-labelledby="faq-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <Reveal client:visible><p class="eyebrow">Good to know</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 id="faq-title" class="h-section mt-5">Frequently asked <em>questions.</em></h2></Reveal>
      </div>
      <div class="grid content-start gap-3 lg:col-span-8">
        {faqs.map((f, i) => (
          <details class="group rounded-2xl border border-ink/10 bg-paper px-6 transition-colors open:border-sky open:bg-white" open={i === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-serif text-xl text-ink [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-ink/15 text-brand transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
            </summary>
            <div class="pb-6 pr-10 text-[1.02rem] leading-8 text-text"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="Sports & performance" secondary={{ label: 'Find a clinic', href: '/locations/' }}>Get back to the <em>game you love.</em></CtaBand>
</BaseLayout>
