---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/islands/Reveal';
import StaffDirectory from '../components/islands/StaffDirectory';
import { BOOK_URL } from '../data/content';
import { ALL_STAFF, GROUPS } from '../data/team';

const members = ALL_STAFF.map(({ slug, name, creds, role, group, image }) => ({ slug, name, creds, role, group, image }));
---

<BaseLayout
  solidHeader
  title="Our Staff | Water & Sports Physical Therapy San Diego"
  description="Meet the physical therapists, directors and assistants of Water & Sports Physical Therapy across our eight San Diego clinics."
>
  <section class="relative isolate overflow-hidden bg-mist/60 pb-14 pt-32 lg:pb-20 lg:pt-44">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-40 top-0 h-[32rem] w-[32rem] rounded-full bg-sky/25 blur-3xl"></div>
      <img src="/images/logo-mark.webp" alt="" class="absolute -bottom-10 -left-16 w-[30rem] opacity-[.07]" />
    </div>
    <div class="wrap text-center">
      <Reveal client:load><p class="eyebrow justify-center">Our Staff</p></Reveal>
      <Reveal client:load delay={0.08}><h1 class="h-display mx-auto mt-5 max-w-3xl">The people who <em>get you moving</em> again.</h1></Reveal>
      <Reveal client:load delay={0.16}><p class="lead mx-auto mt-6 max-w-2xl">{ALL_STAFF.length} physical therapists, directors and assistants, led by Dr. Kahl Goldfarb and working across our eight San Diego clinics.</p></Reveal>
    </div>
  </section>

  <section class="bg-paper py-16 lg:py-24">
    <div class="wrap">
      <StaffDirectory client:load members={members} groups={GROUPS} />
    </div>
  </section>

  <section class="on-blue bg-sky py-16 lg:py-20">
    <div class="wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <h2 class="h-section max-w-xl">Ready to meet <em>your</em> therapist?</h2>
      <a href={BOOK_URL} class="btn btn-gold">Request Appointment</a>
    </div>
  </section>
</BaseLayout>
